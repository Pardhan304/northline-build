NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# Neon PostgreSQL connections
# Runtime pooled connection (pgbouncer=true)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Direct non-pooled connection for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session & security
SESSION_SECRET="replace-with-at-least-32-char-random-secret"
COOKIE_NAME="northline_session"
SESSION_IDLE_TTL_HOURS=24
SESSION_ABSOLUTE_TTL_DAYS=7

# Storage adapter (local for development; s3/r2 for production)
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="uploads"
PUBLIC_ASSET_BASE_URL="http://localhost:5000/uploads"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"

# Optional Next.js on-demand cache revalidation webhook
REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET=""

# Render keep-alive self-ping (defaults to 10 minutes = 600000ms)
# Auto-uses RENDER_EXTERNAL_URL/api/v1/health on Render if KEEP_ALIVE_URL is unset
KEEP_ALIVE_ENABLED="true"
KEEP_ALIVE_URL=""
KEEP_ALIVE_INTERVAL_MS=600000

# Optional logging level: fatal, error, warn, info, debug, trace
LOG_LEVEL="info"

